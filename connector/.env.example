# Token for your custom CRM's inbound endpoint (sinks[].authEnv)
CRM_API_TOKEN=

# Only needed if you enable an http-mode source. Copy the Cookie header from a
# logged-in browser session on that portal. Session cookies expire — `doctor`
# warns when one is missing, and a run fails loudly when one has gone stale.
EUNA_SESSION_COOKIE=
BIDNET_SESSION_COOKIE=

# Set to "json" for structured logs under a hosted scheduler.
LOG_FORMAT=
